{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "npm run test:unit",
    "test:unit": "node --test test/booking/domain.test.js test/booking/time.test.js test/booking/http.test.js test/booking/runtime.test.js test/booking/index.integration.test.js",
    "test:emulator": "node --test test/booking/create.emulator.test.js test/booking/mutations.emulator.test.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "firebase-admin": "^10.0.0",
    "firebase-functions": "^3.18.0",
    "form-data": "^4.0.0",
    "mailgun.js": "^9.4.1",
    "nodemailer": "^6.9.7"
  },
  "private": true
}
