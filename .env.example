# Firebase Configuration (client-side)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional safety switch for a complete, demo-prefixed Firebase configuration.
# With no Firebase client variables, development automatically uses demo-barbersbuddies emulators.
# REACT_APP_FIREBASE_USE_EMULATORS=true

# Optional local persona switch. Blank development enables it automatically.
# It is rejected unless NODE_ENV is development and Firebase uses a demo-* emulator project.
# REACT_APP_DEMO_ACCESS=true

# Stripe
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# TinyMCE
REACT_APP_TINYMCE_API_KEY=your_tinymce_key

# Google APIs
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_key
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id

# Booking v2 commands (production only)
# Each URL must be an explicit HTTPS endpoint ending in the matching function name.
# Development and test use the disposable demo-barbersbuddies emulators instead.
REACT_APP_BOOKING_V2_CREATE_ENDPOINT=https://us-central1-your_project_id.cloudfunctions.net/createBookingV2
REACT_APP_BOOKING_V2_CANCEL_ENDPOINT=https://us-central1-your_project_id.cloudfunctions.net/cancelBookingV2
REACT_APP_BOOKING_V2_RESCHEDULE_ENDPOINT=https://us-central1-your_project_id.cloudfunctions.net/rescheduleBookingV2

# Functions runtime CORS allowlist, configured on the server rather than bundled into React.
# Production commands also require the exact server-side activation flag below.
# BOOKING_V2_ENABLED=true
# BOOKING_V2_ALLOWED_ORIGINS_JSON=["https://your-production-domain.example"]

# Emulator-only demo seed
# Start the Auth and Firestore emulators before running the seed script.
# The seed refuses non-local hosts and project IDs that do not start with "demo-".
SEED_FIREBASE_PROJECT_ID=demo-barbersbuddies
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional per-run demo credential overrides. Emails must end in .invalid.
# Passwords must contain at least 12 characters. Leave unset for random passwords.
# SEED_DEMO_OWNER_EMAIL=owner@barbersbuddies.invalid
# SEED_DEMO_OWNER_PASSWORD=
# SEED_DEMO_CUSTOMER_EMAIL=customer@barbersbuddies.invalid
# SEED_DEMO_CUSTOMER_PASSWORD=
